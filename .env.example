DEBUG=1
SECRET_KEY=django-insecure-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=norsalud
DB_USER=norsalud_user
DB_PASSWORD=norsalud_pass
DB_ROOT_PASSWORD=norsalud_root_pass
DB_HOST=localhost
DB_PORT=3306

# ---- Solo para producción en el VPS (docker-compose.prod.yml) ----
# Ver DEPLOY.md. En desarrollo local deja estas líneas como están (o vacías).
#
# DOMAIN=miapp.ejemplo.com
# CERTBOT_EMAIL=tu_correo@ejemplo.com
# DEBUG=0
# ALLOWED_HOSTS=miapp.ejemplo.com
# CSRF_TRUSTED_ORIGINS=https://miapp.ejemplo.com
# DB_HOST=db
# SECURE_SSL_REDIRECT=1
# SESSION_COOKIE_SECURE=1
# CSRF_COOKIE_SECURE=1
# SECURE_HSTS_SECONDS=31536000

# Correo (RF-02: recuperar contraseña).
# Deja estas 3 líneas comentadas/vacías para que los correos solo se impriman
# en la terminal (modo desarrollo). Para enviar correos reales por Gmail,
# descomenta y completa con una "contraseña de aplicación" (no tu contraseña normal):
# https://myaccount.google.com/apppasswords
#
# ⚠️ EN PRODUCCIÓN ES OBLIGATORIO llenar esto: sin esto, "¿Olvidaste tu
# contraseña?" no le llega el correo a ningún usuario real. Ver la sección
# "4.1 Activar el envío real de correos" en DEPLOY.md.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST_USER=tu_correo@gmail.com
# EMAIL_HOST_PASSWORD=contraseña de aplicacion de 16 caracteres
